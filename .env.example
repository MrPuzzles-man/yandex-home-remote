# Обязателен для реального каталога и команд. OAuth scopes: iot:view iot:control
YANDEX_IOT_TOKEN=
YANDEX_IOT_REFRESH_TOKEN=

# Обязательны для Telegram-бота
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Необязательные настройки
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/home-remote.db
LOG_LEVEL=info
YANDEX_IOT_BASE_URL=https://api.iot.yandex.net
CALLBACK_TTL_SECONDS=300

# Музыка через Home Assistant + AlexxIT/YandexStation
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
YANDEX_STATION_ENTITY_ID=media_player.yandex_station_xxx

# Необязательная телеметрия Music Assistant. Воспроизведением управляет Home Assistant.
# Для Docker Desktop обычно используется http://host.docker.internal:8095
MUSIC_ASSISTANT_URL=
MUSIC_ASSISTANT_TOKEN=
MUSIC_ASSISTANT_PLAYER_ID=
