{
  "name": "yandex-home-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "auth:yandex": "tsx src/tools/auth-yandex.ts",
    "probe:yandex": "tsx src/tools/probe-yandex.ts",
    "docker:up": "docker compose up -d --build",
    "docker:start": "docker compose start",
    "docker:stop": "docker compose stop",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:status": "docker compose ps",
    "ha:logs": "docker compose logs -f homeassistant",
    "ha:restart": "docker compose restart homeassistant",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run typecheck:tests && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "grammy": "^1.38.3",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
